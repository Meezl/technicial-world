{
	frankenphp
}

:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# /storage/* must go through PHP — the public/storage symlink to
	# storage/app/public doesn't reliably work on Railway's deployment
	# layer (returns 403). The StorageController serves files instead.
	@storage path /storage/*
	handle @storage {
		rewrite * /index.php
		php
	}

	# Try files: if file exists serve it, otherwise rewrite to index.php for Laravel
	try_files {path} /index.php

	# PHP handler for all requests
	php
}

