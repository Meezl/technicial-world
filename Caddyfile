{
	frankenphp
}

:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# Serve /storage/* directly from the Railway persistent volume
	# at /app/storage/app/public. Bypasses the (dangling) public/storage
	# symlink and the Laravel round-trip — both of which produced 403s
	# on this deployment layer. handle_path strips the /storage/ prefix
	# before file_server resolves the path against the volume root.
	handle_path /storage/* {
		root * /app/storage/app/public
		file_server
	}

	php_server
}
